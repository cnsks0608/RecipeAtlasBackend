{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "RecipeAtlas.Api",
    "Audience": "RecipeAtlas.Mobile",
    "ExpireDays": 7
  },
  "Account": {
    "DeletionGraceDays": 30
  },
  "RateLimit": {
    "LoginPermitLimit": 5,
    "LoginWindowSeconds": 180
  }
}