{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "RecipeAtlas.Api",
    "Audience": "RecipeAtlas.Mobile",
    "ExpireDays": 7
  },
  "Account": {
    "DeletionGraceDays": 30
  },
  "RateLimit": {
    "LoginPermitLimit": 5,
    "LoginWindowSeconds": 180,
    "RegisterPermitLimit": 3,
    "RegisterWindowSeconds": 600,
    "VerifyPermitLimit": 10,
    "VerifyWindowSeconds": 600
  },
  "Smtp": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "FromName": "RecipeAtlas"
  },
  "Verification": {
    "CodeExpiryMinutes": 10,
    "MaxFailedAttempts": 5
  },
  "Email": {
    "VerificationSubject": "RecipeAtlas'a hoş geldiniz: doğrulama kodunuz",
    "VerificationBody": "Merhaba!\n\nRecipeAtlas'a kayıt olmak için doğrulama kodunuz:\n\n{Code}\n\nBu kod {ExpiryMinutes} dakika geçerlidir. Bu işlemi siz yapmadıysanız bu e-postayı yok sayabilirsiniz."
  }
}